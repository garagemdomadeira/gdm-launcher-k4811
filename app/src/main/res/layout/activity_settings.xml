<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings. 1280×720. No dock. The options are built in code (OptionList). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.garagemdomadeira.nwd.launcher.ui.IconView
            android:id="@+id/settings_back"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="32sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

    <!-- Group column (Settings only; Advanced and Dock leave it hidden). One panel per tab. -->
    <LinearLayout
        android:id="@+id/settings_sidebar"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_marginRight="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/settings_tab_main"
            style="@style/SettingsTab"
            android:text="@string/settings_group_main" />

        <TextView
            android:id="@+id/settings_tab_assists"
            style="@style/SettingsTab"
            android:text="@string/settings_group_assists" />

        <TextView
            android:id="@+id/settings_tab_system"
            style="@style/SettingsTab"
            android:text="@string/settings_group_system" />

        <TextView
            android:id="@+id/settings_tab_advanced"
            style="@style/SettingsTab"
            android:text="@string/settings_advanced"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <!-- Platform compatibility warning (PlatformCompat). -->
            <TextView
                android:id="@+id/settings_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/panel"
                android:padding="18dp"
                android:textSize="19sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/settings_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/crash_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/crash_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_crash_title"
                        android:textColor="#FFFF6B6B"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/crash_clear"
                        style="@style/PillButton"
                        android:text="@string/settings_crash_clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/crash_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/log_bg"
                    android:padding="12dp"
                    android:textColor="@color/text_muted"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</LinearLayout>
