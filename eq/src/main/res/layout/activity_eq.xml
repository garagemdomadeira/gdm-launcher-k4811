<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:background="@drawable/panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.k4811.common.ui.IconView
            android:id="@+id/eq_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/eq_back" />

        <TextView
            android:id="@+id/tab_eq"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="@string/eq_tab_eq"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tab_site"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="@string/eq_tab_site"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tab_channels"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="@string/eq_tab_channels"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tab_gain"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="@string/eq_tab_gain"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tab_diag"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="@string/eq_tab_diag"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/eq_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MCU"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_weight="1">

        <!-- Equalizer -->
        <LinearLayout
            android:id="@+id/panel_eq"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loudness, Influence, Reset, Apply at startup -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/eq_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/eq_bands"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Presets, at the bottom -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/eq_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Sound field -->
        <LinearLayout
            android:id="@+id/panel_site"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/panel"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <com.k4811.audioset.ui.SitePadView
                android:id="@+id/site_pad"
                android:layout_width="320dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_site_title"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/eq_site_hint"
                    android:textColor="@color/text_muted"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/site_seats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/site_fader_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/site_balance_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/site_up"
                        android:layout_width="64dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pill"
                        android:gravity="center"
                        android:text="▲"
                        android:textColor="@color/text"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/site_left"
                            android:layout_width="64dp"
                            android:layout_height="48dp"
                            android:background="@drawable/pill"
                            android:gravity="center"
                            android:text="◀"
                            android:textColor="@color/text"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/site_right"
                            android:layout_width="64dp"
                            android:layout_height="48dp"
                            android:layout_marginLeft="6dp"
                            android:background="@drawable/pill"
                            android:gravity="center"
                            android:text="▶"
                            android:textColor="@color/text"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/site_down"
                        android:layout_width="64dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/pill"
                        android:gravity="center"
                        android:text="▼"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Channels -->
        <HorizontalScrollView
            android:id="@+id/panel_channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/panel"
            android:padding="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/channels_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Volume por fonte: ganho de cada fonte no DSP (/cache/FactoryConfig.ini; montado pelo SourceGainPanel) -->
        <ScrollView
            android:id="@+id/panel_gain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/panel"
            android:padding="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/gain_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </ScrollView>

        <!-- Diagnostics -->
        <LinearLayout
            android:id="@+id/panel_diag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/panel"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ScrollView
                android:layout_width="360dp"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/diag_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/diag_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
