<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- /sdcard/nwd-configs/launcher.json e arquivos de configuração da central. Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Meus EQs: exportar para o pen drive (EQ_Setup); a de mídia vale como priv-app na ROM. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Reaplicar o som salvo ao ligar a central. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name="com.k4811.common.SuiteApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Apps com targetSdk < 26 ganham um limite de proporção de 1,86 (tela "encaixotada");
             liberamos até 2,4 para ocupar os 1280×720 inteiros. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!-- Única tela: equalizador pela MCU (SettingService) ou pelo DSP ARM. -->
        <activity
            android:name=".EqActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nome da Activity do app original: o sistema e outros apps abrem por este componente. -->
        <activity-alias
            android:name="com.nwd.audioset.home_horizontalActivity"
            android:exported="true"
            android:targetActivity=".EqActivity" />


        <!-- Reaplica o som salvo no boot e ao sair do ACC (papel do DspServices do original). -->
        <service
            android:name=".eq.EqBootService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nwd.ACTION_DSP_SERVICE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".eq.EqBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.nwd.action.ACTION_MCU_STATE_CHANGE" />
                <action android:name="com.nwd.action.ACTION_REINIT_DSP_DATA" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
