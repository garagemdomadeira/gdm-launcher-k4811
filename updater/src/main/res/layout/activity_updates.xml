<?xml version="1.0" encoding="utf-8"?>
<!-- GDM Atualizações: o que há de novo (apps e ROM), procurar agora e Confirmar update. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ota_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ota_app_name"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/ota_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ota_check"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:text="@string/ota_check_now"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/ota_close"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="14dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ota_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/ota_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_soft"
        android:textSize="18sp" />

    <FrameLayout
        android:id="@+id/ota_progress_track"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/progress_track"
        android:visibility="invisible">

        <View
            android:id="@+id/ota_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/progress_fill" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ota_confirm"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:gravity="center"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:text="@string/ota_confirm"
            android:textColor="#FF06210F"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
