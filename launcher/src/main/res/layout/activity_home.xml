<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen: content area 1280×560 (the dock is attached at the bottom by Screens.attachDock).
    Top bar: voltmeter (left) · screen off and settings (right).
    Below it, the modules (now playing, clock, volume, fan, Bluetooth, image, speed, GPS data) have
    no position here: HomeModuleViews places each one in its slot of the HomeGrid and sizes it for
    that slot.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Optional background picture chosen in Settings; hidden when none, falling back to @color/background. -->
    <ImageView
        android:id="@+id/home_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/settings_home_bg_image"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Free area: holding ~1 s opens Android Settings (emergency exit). -->
    <View
        android:id="@+id/home_space"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===== Screen off and settings ===== -->
    <com.k4811.common.ui.IconView
        android:id="@+id/screen_off_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|right"
        android:layout_marginRight="104dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/home_screen_off" />

    <com.k4811.common.ui.IconView
        android:id="@+id/settings_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|right"
        android:layout_marginRight="22dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/home_settings" />

    <!-- ===== Barra de ícones de estado (StatusStrip): no alto, no centro, acima do relógio ===== -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- ===== Clock module ===== -->
    <LinearLayout
        android:id="@+id/clock_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="00:00"
            android:textColor="@color/text"
            android:textSize="158sp" />

        <TextView
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:textColor="@color/text_soft"
            android:textSize="30sp" />
    </LinearLayout>

    <!-- ===== Top left: day/night · battery voltage · what is playing ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Day (sun) or night (moon = headlights on) -->
        <com.k4811.common.ui.IconView
            android:id="@+id/day_night"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="24dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <!-- Battery voltage (CAN): only shown if the head unit responds -->
        <LinearLayout
            android:id="@+id/voltage"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="32dp"
            android:contentDescription="@string/home_battery_voltage"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.k4811.common.ui.IconView
                android:id="@+id/voltage_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/voltage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- What is playing (Radio / MP3 / BT); hidden when nothing is -->
        <LinearLayout
            android:id="@+id/source_badge"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:visibility="gone">

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/status_dot"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/source_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Volume module: − mute + ===== -->
    <LinearLayout
        android:id="@+id/volume_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.k4811.common.ui.IconView
            android:id="@+id/volume_down"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/home_volume_down" />

        <com.k4811.common.ui.IconView
            android:id="@+id/volume_mute"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/home_mute" />

        <com.k4811.common.ui.IconView
            android:id="@+id/volume_up"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/home_volume_up" />
    </LinearLayout>

    <!-- ===== Now playing module: cover above the text (tall slot) or beside it (other slots) ===== -->
    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Album cover (MP3) or source icon (radio, Bluetooth). -->
        <FrameLayout
            android:id="@+id/np_art_frame"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/art_frame"
            android:padding="1dp">

            <com.k4811.common.ui.IconView
                android:id="@+id/np_art_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />

            <ImageView
                android:id="@+id/np_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/home_cover"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/np_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fonte: ícone, nome e a setinha; toque escolhe Automático, Rádio, MP3, BT ou um app de música. -->
            <LinearLayout
                android:id="@+id/np_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-6dp"
                android:background="@drawable/chip"
                android:clickable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="4dp">

                <ImageView
                    android:id="@+id/np_source_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/np_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.2"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/text_muted"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/np_source_arrow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:rotation="90"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ms_chevron_right" />
            </LinearLayout>

            <TextView
                android:id="@+id/np_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/np_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="24sp"
                android:visibility="gone" />

            <!-- Álbum ou o texto que a rádio manda (RDS) -->
            <TextView
                android:id="@+id/np_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="18sp"
                android:visibility="gone" />

            <!-- Memória, estéreo, TP/TA; faixa, ano, gênero; formato do arquivo -->
            <TextView
                android:id="@+id/np_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Thin progress bar -->
            <FrameLayout
                android:id="@+id/np_progress_track"
                android:layout_width="150dp"
                android:layout_height="4dp"
                android:background="@drawable/progress_track">

                <View
                    android:id="@+id/np_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/progress_fill"
                    android:scaleX="0"
                    android:transformPivotX="0px" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/np_times"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/np_pos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/np_dur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/np_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.k4811.common.ui.IconView
                    android:id="@+id/np_prev"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="@string/home_previous" />

                <com.k4811.common.ui.IconView
                    android:id="@+id/np_play"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="@string/home_play_pause" />

                <com.k4811.common.ui.IconView
                    android:id="@+id/np_next"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="@string/home_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Tempo (clima do ambiente): ícone (sol/chuva/nublado) + temperatura; em pé, à esquerda do tocando-agora ===== -->
    <LinearLayout
        android:id="@+id/home_clima"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.k4811.common.ui.IconView
            android:id="@+id/home_clima_icon"
            android:layout_width="68dp"
            android:layout_height="68dp" />

        <TextView
            android:id="@+id/home_clima_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text"
            android:textSize="32sp" />
    </LinearLayout>

    <!-- ===== Call: covers the "now playing" slot (or the left slot if it's hidden) ===== -->
    <LinearLayout
        android:id="@+id/card_call"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/panel"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/call_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:textColor="@color/text_muted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/call_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/call_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_answer"
                style="@style/PillButton"
                android:layout_height="60dp"
                android:text="@string/home_answer"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/call_hangup"
                style="@style/PillButton"
                android:layout_height="60dp"
                android:text="@string/home_hang_up"
                android:textColor="#FFFF6B6B"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Fan module ===== -->
    <LinearLayout
        android:id="@+id/fan_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:contentDescription="@string/home_fan"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <com.k4811.common.ui.IconView
            android:id="@+id/fan_status_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/fan_status_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fan_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/home_fan_caps"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/fan_status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/fan_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:includeFontPadding="false"
                    android:text="@string/home_fan_off"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Bluetooth module ===== -->
    <LinearLayout
        android:id="@+id/bt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:contentDescription="@string/home_bluetooth"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <com.k4811.common.ui.IconView
            android:id="@+id/bt_status_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="false"
            android:duplicateParentState="true"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/bt_status_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bt_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/home_bt_disconnected"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/bt_status_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Image module: only the picture chosen in Settings, cropped to fill the slot (no frame) ===== -->
    <FrameLayout
        android:id="@+id/image_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <TextView
            android:id="@+id/image_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/home_image_empty"
            android:textColor="@color/text_dim"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/home_image"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== Speed module: GPS speed in km/h ===== -->
    <LinearLayout
        android:id="@+id/speed_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/home_gps_none"
            android:textColor="@color/text"
            android:textSize="150sp" />

        <TextView
            android:id="@+id/speed_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/home_speed_unit"
            android:textColor="@color/text_soft"
            android:textSize="30sp" />
    </LinearLayout>

    <!-- ===== GPS data module: latitude, longitude, altitude, heading ===== -->
    <LinearLayout
        android:id="@+id/gps_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/gps_rows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gps_lat_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_lat"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/gps_lat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_none"
                    android:textColor="@color/text"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gps_lon_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_lon"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/gps_lon_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_none"
                    android:textColor="@color/text"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gps_alt_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_alt"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/gps_alt_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_none"
                    android:textColor="@color/text"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gps_dir_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_dir"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/gps_dir_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/home_gps_none"
                    android:textColor="@color/text"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Carro: o carro 3D (modelo, cor e placa) ou uma foto; toque abre as opções ===== -->
    <FrameLayout
        android:id="@+id/car_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:visibility="gone">

        <com.k4811.launcher.car.Car3DView
            android:id="@+id/car_3d"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/car_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/car_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/home_car_photo_pick"
            android:textColor="@color/text_muted"
            android:textSize="20sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== OBD2 com o relógio: hora, data e a luz da injeção à esquerda; velocidade, marcha, RPM, motor,
         bateria e combustível pelo ELM327 (sem ele, a velocidade do GPS) ===== -->
    <LinearLayout
        android:id="@+id/obd_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/obd_clock_col"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/obd_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/obd_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/obd_mil_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/obd_mil_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ms_info" />

                <TextView
                    android:id="@+id/obd_mil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:singleLine="true"
                    android:text="@string/home_obd_none"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/obd_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:background="@color/hairline" />

        <LinearLayout
            android:id="@+id/obd_cells"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/obd_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/obd_speed_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/obd_speed_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ms_speed" />

                    <TextView
                        android:id="@+id/obd_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/home_obd_none"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/obd_rpm_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/obd_rpm_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ms_directions_car" />

                    <TextView
                        android:id="@+id/obd_rpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/home_obd_none"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/obd_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/obd_gear_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/obd_gear_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ms_settings_input_component" />

                    <TextView
                        android:id="@+id/obd_gear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/home_obd_none"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/obd_temp_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/obd_temp_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ms_device_thermostat" />

                    <TextView
                        android:id="@+id/obd_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/home_obd_none"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/obd_row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/obd_volts_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/obd_volts_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ms_battery_full" />

                    <TextView
                        android:id="@+id/obd_volts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/home_obd_none"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/obd_fuel_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/obd_fuel_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ms_local_gas_station" />

                    <TextView
                        android:id="@+id/obd_fuel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/home_obd_none"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/obd_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== PIP: um app de verdade (Waze, Maps, Spotify…) rodando dentro da tela inicial ===== -->
    <FrameLayout
        android:id="@+id/pip_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/art_frame"
        android:padding="1dp"
        android:visibility="gone">

        <com.k4811.launcher.pip.PipView
            android:id="@+id/pip_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/pip_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/home_pip_empty"
                android:textColor="@color/text_muted"
                android:textSize="20sp" />
        </com.k4811.launcher.pip.PipView>

        <!-- Trocar o app do PIP / abrir em tela cheia -->
        <LinearLayout
            android:id="@+id/pip_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="8dp"
            android:background="@drawable/chip"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pip_swap"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ms_apps" />

            <ImageView
                android:id="@+id/pip_full"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ms_open_full" />
        </LinearLayout>
    </FrameLayout>

    <!-- Screen off: black layer over everything; any touch turns the backlight back on. -->
    <View
        android:id="@+id/screen_off_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:contentDescription="@string/home_tap_to_wake"
        android:visibility="gone" />
</FrameLayout>
