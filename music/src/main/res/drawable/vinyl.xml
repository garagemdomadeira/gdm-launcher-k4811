<?xml version="1.0" encoding="utf-8"?>
<!-- Disco de vinil: corpo preto com sulcos concêntricos, um realce de luz e o selo central (com o furo). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <!-- corpo do disco -->
    <path
        android:pathData="M120,8 a112,112 0 1,0 0.1,0 z"
        android:fillColor="#FF0C0C0F" />
    <!-- borda -->
    <path
        android:pathData="M120,8 a112,112 0 1,0 0.1,0 z"
        android:strokeColor="#FF1E1E22"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- sulcos concêntricos -->
    <path android:pathData="M120,24 a96,96 0 1,0 0.1,0 z" android:strokeColor="#FF17171B" android:strokeWidth="1.4" android:fillColor="#00000000" />
    <path android:pathData="M120,36 a84,84 0 1,0 0.1,0 z" android:strokeColor="#FF202026" android:strokeWidth="1.4" android:fillColor="#00000000" />
    <path android:pathData="M120,48 a72,72 0 1,0 0.1,0 z" android:strokeColor="#FF17171B" android:strokeWidth="1.4" android:fillColor="#00000000" />
    <path android:pathData="M120,60 a60,60 0 1,0 0.1,0 z" android:strokeColor="#FF202026" android:strokeWidth="1.4" android:fillColor="#00000000" />
    <path android:pathData="M120,74 a46,46 0 1,0 0.1,0 z" android:strokeColor="#FF17171B" android:strokeWidth="1.4" android:fillColor="#00000000" />

    <!-- brilho (reflexo) de um lado -->
    <path
        android:pathData="M120,12 a108,108 0 0,1 76,32 l-10,10 a94,94 0 0,0 -66,-28 z"
        android:fillColor="#141E6BFF" />

    <!-- selo central -->
    <path
        android:pathData="M120,86 a34,34 0 1,0 0.1,0 z"
        android:fillColor="#FF2B6CFF" />
    <path
        android:pathData="M120,86 a34,34 0 1,0 0.1,0 z"
        android:strokeColor="#FF1E53CC"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- furo central -->
    <path
        android:pathData="M120,114 a6,6 0 1,0 0.1,0 z"
        android:fillColor="#FF0C0C0F" />
</vector>
