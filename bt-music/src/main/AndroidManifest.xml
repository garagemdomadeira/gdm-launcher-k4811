<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- /sdcard/nwd-configs/launcher.json. Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name="com.k4811.common.SuiteApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Apps com targetSdk < 26 ganham um limite de proporção de 1,86 (tela "encaixotada");
             liberamos até 2,4 para ocupar os 1280×720 inteiros. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!-- Única tela, como no com.nwd.bt.music original (singleTask, fora dos recentes). -->
        <activity
            android:name=".BtMusicActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nome da Activity do app original: o sistema e outros apps abrem por este componente. -->
        <activity-alias
            android:name="com.nwd.bt.music.home_horizontalActivity"
            android:exported="true"
            android:targetActivity=".BtMusicActivity" />


        <!-- Carro ligou com a música BT como última fonte: retoma sem abrir a tela (como o original). -->
        <receiver
            android:name=".BackgroundPlayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nwd.ACTION_BACKGROUND_MEDIA_PLAY" />
            </intent-filter>
        </receiver>

        <service
            android:name=".BtResumeService"
            android:exported="false" />
        <!-- ROM K4811: nome que o KernelService da NWD usa para abrir esta fonte (SourceConstant: botão MODE) -->
        <activity-alias
            android:name="com.nwd.bt.music.BTMusicActivity"
            android:exported="true"
            android:targetActivity=".BtMusicActivity" />
    </application>
</manifest>
