<?xml version="1.0" encoding="utf-8"?>
<!--
    Bluetooth music, minimalist: header, thin line and the centered track.
    Content area 1280×560 (the dock is attached at the bottom).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bt_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="24dp"
    android:paddingTop="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.k4811.common.ui.IconView
            android:id="@+id/bt_music_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/media_back" />

        <TextView
            android:id="@+id/bt_music_title_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="Bluetooth"
            android:textColor="@color/text"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/bt_music_phone"
            style="@style/LineButton"
            android:text="@string/media_bt_phone" />
    </LinearLayout>

    <View
        style="@style/HairlineH"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="120dp"
        android:paddingRight="120dp"
        android:paddingTop="56dp">

        <!-- Device: small icon + name, as a caption -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.k4811.common.ui.IconView
                android:id="@+id/bt_music_mark"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/bt_music_device"
                style="@style/Caption"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:maxWidth="600dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bt_music_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="—"
            android:textColor="@color/text"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/bt_music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="24sp" />

        <!-- Short stroke separating the track from the controls -->
        <View
            android:layout_width="96dp"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/hairline_strong" />

        <LinearLayout
            android:id="@+id/bt_music_transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.k4811.common.ui.IconView
                android:id="@+id/bt_music_prev"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/media_previous" />

            <com.k4811.common.ui.IconView
                android:id="@+id/bt_music_play"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginLeft="44dp"
                android:layout_marginRight="44dp"
                android:contentDescription="@string/media_play_pause" />

            <com.k4811.common.ui.IconView
                android:id="@+id/bt_music_next"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/media_next" />
        </LinearLayout>

        <TextView
            android:id="@+id/bt_music_status"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp"
            android:gravity="center" />

        <!-- Disco de vinil girando (estilo HTG Play): preenche a parte de baixo; gira enquanto toca. -->
        <ImageView
            android:id="@+id/bt_music_vinyl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:alpha="0.6"
            android:contentDescription="@string/media_music_cover"
            android:scaleType="fitCenter"
            android:src="@drawable/vinyl" />
    </LinearLayout>
</LinearLayout>
