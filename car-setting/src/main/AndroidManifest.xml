<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Settings.System (chaves da NWD) e pedido de alterar props ("nwd_system_prop"), como o
         launcher padrão. Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- /sdcard/nwd-configs/launcher.json (este app é o dono) e exportar as props para Download/.
         Com targetSdk < 23 são concedidas na instalação. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Aba Conexões: Wi-Fi, Bluetooth do Android e roteador Wi-Fi (ConnectionsPanel, system/Hotspot).
         Ligar/desligar o roteador vale com WRITE_SETTINGS; nome e senha só com OVERRIDE_WIFI_CONFIG,
         concedida quando o app está em /system/priv-app na ROM. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission
        android:name="android.permission.OVERRIDE_WIFI_CONFIG"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.TETHER_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".SettingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Apps com targetSdk < 26 ganham um limite de proporção de 1,86 (tela "encaixotada");
             liberamos até 2,4 para ocupar os 1280×720 inteiros. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!-- Tela principal, como no com.android.car.setting original (singleTask, launcher).
             Aberta pela engrenagem do launcher. -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Customizar tela inicial: mapa das 6 áreas e os módulos de cada uma. -->
        <activity
            android:name=".HomeSettingsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- Avançado (com senha): fábrica, desenvolvimento e menus da NWD. -->
        <activity
            android:name=".AdvancedActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />

        <!-- Props do sistema (dentro do Avançado). -->
        <activity
            android:name=".DevPropsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="nosensor" />
    </application>
</manifest>
