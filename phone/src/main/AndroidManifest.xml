<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- /sdcard/nwd-configs/launcher.json. Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Janela flutuante da chamada por cima dos outros apps (e abrir a tela em segundo plano no
         Android 10). Com targetSdk < 23 é concedida na instalação. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name="com.k4811.common.SuiteApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Apps com targetSdk < 26 ganham um limite de proporção de 1,86 (tela "encaixotada");
             liberamos até 2,4 para ocupar os 1280×720 inteiros. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!-- Única tela, como no com.nwd.android.phone original (singleTask). -->
        <activity
            android:name=".PhoneActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nome da Activity do app original: o sistema e outros apps abrem por este componente. -->
        <activity-alias
            android:name="com.nwd.android.phone.home_horizontalActivity"
            android:exported="true"
            android:targetActivity=".PhoneActivity" />


        <!-- Chamada recebida ou efetuada: tela do telefone (se na frente) ou janela flutuante. -->
        <receiver
            android:name=".CallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.bt.ACTION_BT_INCOMING_CALL" />
                <action android:name="com.bt.ACTION_BT_OUTGOING_CALL" />
                <action android:name="com.bt.ACTION_BT_INCOMING_NUMBER" />
                <action android:name="com.bt.ACTION_BT_INCOMING_NAME" />
                <action android:name="com.bt.ACTION_BT_OUTGOING_NUMBER" />
                <action android:name="com.bt.ACTION_BT_OUTGOING_NAME" />
                <!-- Tela inicial mostrando o próprio cartão da ligação (esconde a janela flutuante). -->
                <action android:name="com.k4811.action.HOME_CALL_CARD" />
            </intent-filter>
        </receiver>

        <!-- Janela flutuante da chamada (papel do FloatBar do original). -->
        <service
            android:name=".CallFloatService"
            android:exported="false" />
        <!-- ROM K4811: nome que o KernelService da NWD usa para abrir esta fonte (SourceConstant: botão MODE) -->
        <activity-alias
            android:name="com.nwd.android.phone.StartBT"
            android:exported="true"
            android:targetActivity=".PhoneActivity" />
    </application>
</manifest>
